# Manao stage-one Pi worker environment. Every field is empty on purpose: nothing
# in this repository carries a real value. Copy to .env (never committed) and fill
# before running. The worker refuses to start while the non-model fields are
# missing, and refuses task starts while the model fields are missing.

# --- worker HTTP surface (the backend's MANAO_AI_WORKER_* points here) ---
MANAO_AI_WORKER_PORT=18090
# Shared secret the backend must present on /tasks/*; empty disables every route.
MANAO_AI_WORKER_TOKEN=
# Stable instance identity of this worker process (any unique string).
MANAO_AI_INSTANCE_ID=

# --- backend internal routes (worker -> backend callbacks) ---
MANAO_AI_BACKEND_BASE_URL=
MANAO_AI_BACKEND_TOKEN=

# --- worker-private paths (never a user project, never a shared volume) ---
MANAO_AI_SCRATCH_DIR=
MANAO_AI_AGENT_DIR=
MANAO_AI_SESSION_DIR=

# --- model configuration (worker-side only; the backend never sees these) ---
MANAO_AI_PROVIDER=
MANAO_AI_API_TYPE=
MANAO_AI_BASE_URL=
MANAO_AI_MODEL=
MANAO_AI_API_KEY=
