# 6A local-cluster profile: example environment (copy to a location outside the repo and fill in).
# NEVER commit real values, tokens, keys or cluster addresses.

# Local MySQL (6A uses the developer machine's MySQL)
MANAO_DB_URL=jdbc:mysql://127.0.0.1:3306/manao_poc4
MANAO_DB_USERNAME=manao
MANAO_DB_PASSWORD=change-me

# JWT signing secret (32+ chars)
MANAO_JWT_SECRET=change-me-32-chars-minimum
MANAO_JWT_LIFETIME=15m

# Workspace capability Ed25519 key pair (base64 of raw 32-byte keys; must be a matching pair)
MANAO_WORKSPACE_CAPABILITY_PRIVATE_KEY=base64-private-key
MANAO_WORKSPACE_CAPABILITY_PUBLIC_KEY=base64-public-key

# Immutable Maven runner image (digest-pinned by the deploy environment)
MANAO_MAVEN_RUNNER_IMAGE=registry.example/manao/maven-runner@sha256:...

# Target namespace inside the test cluster
MANAO_K8S_NAMESPACE=manao

# Temporary kubeconfig whose server points at the SSH-forwarded local API endpoint.
# The cluster entry MUST set tls-server-name to a real certificate SAN and keep the CA.
KUBECONFIG=C:\path\outside\repo\manao-stage6-kubeconfig

# SSH API tunnel itself is started separately by the operator (Xshell or ssh -L), e.g.:
#   ssh -L 6443:<api-server>:443 <operator-host>
# The backend only consumes the forwarded endpoint declared in the kubeconfig above.
