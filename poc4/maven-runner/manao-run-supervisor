#!/bin/bash
# Fixed entrypoint for the single-run web supervisor. Only "run" and "probe" are
# production modes, each taking an optional enumerated service profile
# (java-spring-boot-web | python-fastapi-web); omitting the profile keeps the legacy
# Java default for already-created resources. Unknown profiles and extra arguments are
# rejected immediately. The run mode always executes the fixed command of the resolved
# profile; no command can be passed in from the environment. Root-owned 0555, same
# trust pattern as manao-pty-wrapper.
exec java -cp /opt/manao-runner/classes com.manao.runtime.WebRunSupervisor "$@"
