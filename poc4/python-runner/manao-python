#!/bin/bash
# manao-python - fixed Python entrypoint of the Manao run containers (python runtime plan,
# task 4). Root-owned 0555 image content (same trust pattern as manao-run-supervisor); it
# prepares the private per-project uv cache and the per-run venv and then execs the only
# two production modes. Nothing else is accepted: no extra arguments, no unknown mode, no
# environment-driven command or health path.
#   manao-python console   execs the project's main.py with the prepared venv
#                          (console TASK, PID 1)
#   manao-python web       execs uvicorn app.main:app on $MANAO_PRIMARY_PORT
#                          (supervised child; readiness stays the supervisor profile's
#                          fixed /health/ready on the same port)
#
# Mount contract (design section 6): the project code is the container working directory
# (/workspace); the private per-project uv cache is mounted at /python-cache (the
# workspace PVC's .manao-cache/python subPath, reclaimed with project deletion); the venv
# /tmp/manao-python/.venv lives only for the current Run and dies with the Pod.
#
# Seed algorithm (design section 6, one seed for the fixed uv/Python/platform toolchain):
# the image carries a read-only seed (/opt/manao-python-seed) whose seed-id pins uv,
# Python, platform and the exact template dependency content. The seed decision keys on
# the target cache directory's existence: a missing /python-cache/uv-cache (first Run, or
# a subPath whose contents were lost) is initialized exactly once, wholly, by copying the
# seed into a temporary same-volume directory that is atomically renamed into place; the
# completion marker seeded-<id> is published last, so an interrupted initialization can
# never leave a marker, and a stale marker left behind by a lost cache directory is
# rewritten on the re-seed. A cache directory that exists is never copied over — uv
# manages it from there, whatever seed id produced it. Staging directories a killed
# previous run left behind are swept before re-seeding; a project has at most one active
# run, so they can have no other owner. Failures are fail-closed before any user code
# runs.
#
# Package preparation always happens after the supervisor claim (this script is the
# supervised child in web mode and the TASK itself in console mode) and therefore inside
# the startup budget. A failed preparation exits non-zero before the application starts.
# All preparation logs share the caller's stdout/stderr; the script never prints
# environment values or credentials, and the fixed uv argv has no user-controlled parts.
set -euo pipefail
# Keep the stop contract responsive during package preparation: for console runs this
# script is PID 1 and the kernel ignores untrapped SIGTERM for PID 1 (same pattern as
# manao-maven). The final exec replaces the shell, so the application keeps its own
# signal handling.
trap 'exit 143' TERM INT

die() { echo "manao-python: $1" >&2; exit 1; }

usage_exit() { echo "manao-python: $1" >&2; exit 2; }

# 1. Mode discipline before any cache, venv or install work: exactly one of the two
# production modes, no extra arguments, and web needs the server-provided primary port.
case "${1:-}" in
  console)
    [ "$#" -eq 1 ] || usage_exit "unexpected arguments after the mode"
    ;;
  web)
    [ "$#" -eq 1 ] || usage_exit "unexpected arguments after the mode"
    case "${MANAO_PRIMARY_PORT:-}" in
      ''|*[!0-9]*) usage_exit "web mode requires the server-provided MANAO_PRIMARY_PORT" ;;
    esac
    [ "$MANAO_PRIMARY_PORT" -ge 1 ] && [ "$MANAO_PRIMARY_PORT" -le 65535 ] \
      || usage_exit "MANAO_PRIMARY_PORT out of range"
    ;;
  *)
    usage_exit "unknown mode (want console or web)"
    ;;
esac

# 2. Fixed toolchain environment: the venv is per-Run, the cache private per project,
# the interpreter is the image's own, and nothing is downloaded from outside the cache
# when the locked dependencies are already there.
export UV_PROJECT_ENVIRONMENT=/tmp/manao-python/.venv
export UV_CACHE_DIR=/python-cache/uv-cache
export UV_LINK_MODE=copy
export UV_PYTHON_DOWNLOADS=never
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

# 3. Server-controlled extras: only the two fixed booleans exist; they pin the --extra
# arguments, never an arbitrary array.
extras=()
if [[ "${MANAO_PYTHON_MYSQL:-false}" == true ]]; then extras+=(--extra mysql); fi
if [[ "${MANAO_PYTHON_REDIS:-false}" == true ]]; then extras+=(--extra redis); fi

# 4. Seed identity and private cache usability (fail-closed, bounded, credential-free
# diagnostics).
SEED_ROOT="/opt/manao-python-seed"
CACHE_ROOT="/python-cache"
[ -d "$SEED_ROOT/uv-cache" ] || die "image seed cache is missing"
[ -r "$SEED_ROOT/seed-id" ] || die "image seed version file is missing"
SEED_ID="$(tr -d '[:space:]' < "$SEED_ROOT/seed-id")"
case "$SEED_ID" in
  *[!0-9a-f]*|'') die "image seed version has an unexpected format" ;;
esac
[ "${#SEED_ID}" -eq 64 ] || die "image seed version has an unexpected length"
[ -d "$CACHE_ROOT" ] || die "project cache directory is not mounted"
if ! : > "$CACHE_ROOT/.manao-write-probe.$$" 2>/dev/null; then
  die "project cache directory is not writable"
fi
rm -f "$CACHE_ROOT/.manao-write-probe.$$"

# 5. One-time whole-seed initialization keyed on the TARGET CACHE DIRECTORY's existence:
# a missing directory (first Run, or a subPath whose contents were lost) is seeded afresh
# — even when a stale completion marker survived — and this seed's marker is published
# last (overwriting any stale copy of it). A cache directory that DOES exist is never
# copied over: uv manages it from there, whatever seed id produced it.
MARKER="$CACHE_ROOT/seeded-$SEED_ID"
if [ ! -d "$CACHE_ROOT/uv-cache" ]; then
  rm -rf "$CACHE_ROOT"/.manao-seed.* 2>/dev/null || true
  seed_tmp="$CACHE_ROOT/.manao-seed.$$"
  mkdir "$seed_tmp" 2>/dev/null || die "cannot create the seed staging directory"
  if ! cp -R "$SEED_ROOT/uv-cache/." "$seed_tmp/"; then
    rm -rf "$seed_tmp"
    die "cannot initialize the project cache from the image seed"
  fi
  mv "$seed_tmp" "$CACHE_ROOT/uv-cache" || {
    rm -rf "$seed_tmp"
    die "cannot publish the project cache directory"
  }
  marker_tmp="$CACHE_ROOT/.manao-marker.$$"
  printf '%s\n' "$SEED_ID" > "$marker_tmp" || die "cannot write the cache completion marker"
  mv "$marker_tmp" "$MARKER" || {
    rm -f "$marker_tmp"
    die "cannot publish the cache completion marker"
  }
fi

# 6. Install the locked dependencies into the per-Run venv. A preparation failure exits
# non-zero here — the application must never start with an uninstalled or mismatched
# environment. uv's own diagnostics are the only output; they carry no credentials.
if ! uv sync --locked --no-dev --no-build --no-config --python /usr/local/bin/python3 "${extras[@]}"; then
  echo "manao-python: package preparation failed; the application will not start" >&2
  exit 1
fi

# 7. Exec the one fixed application command of the mode; exec keeps signal semantics and
# the exit code (console TASK PID 1, supervised child of the web supervisor).
case "$1" in
  console)
    exec /tmp/manao-python/.venv/bin/python -u main.py
    ;;
  web)
    exec /tmp/manao-python/.venv/bin/python -u -m uvicorn app.main:app \
      --host 0.0.0.0 --port "$MANAO_PRIMARY_PORT"
    ;;
esac
