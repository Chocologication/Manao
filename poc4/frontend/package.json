{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173",
    "dev:mock": "vite --mode mock --port 4173",
    "dev:echo": "node scripts/echo-ws.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:boundary": "node --test scripts/browser-boundary-lib.test.mjs scripts/check-browser-boundary.test.mjs && node scripts/check-browser-boundary.mjs",
    "build": "pnpm typecheck && vite build",
    "build:mock": "pnpm typecheck && vite build --mode mock",
    "preview": "vite preview --port 4173",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:channels": "playwright test --project=chrome --project=edge",
    "test:e2e:large-files": "playwright test tests/e2e/stage2-large-files.spec.ts --project=chromium-large-files",
    "test:e2e:large-writes": "playwright test tests/e2e/stage3-large-writes.spec.ts --project=chromium-large-writes",
    "test:e2e:large-logs": "playwright test tests/e2e/stage4-large-logs.spec.ts --project=chromium-large-logs",
    "test:e2e:terminal-stress": "playwright test tests/e2e/stage5-terminal-stress.spec.ts --project=chromium-terminal-stress",
    "test:e2e:stage6": "playwright test tests/e2e/stage6-real-backend.spec.ts --project=stage6"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "5.101.4",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/addon-search": "0.17.0-beta.299",
    "@xterm/addon-webgl": "0.20.0-beta.298",
    "@xterm/xterm": "6.1.0-beta.302",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "msw": "2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  },
  "msw": {
    "workerDirectory": [
      "public-mock"
    ]
  }
}
