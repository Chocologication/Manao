# Stage 6B backend deployment configuration template (poc4/deploy/6b).
# Copy to a PRIVATE location, fill in real values, and never commit the filled file.
# Only two values live in a ConfigMap; every credential / pinned image goes into a Secret.

# --- ConfigMap manao-backend-config (non-secret) ---

# Exact public origin of the web entry, protocol + host + port, e.g. http://203.0.113.7:30080.
# Must equal PUBLIC_ORIGIN used by the frontend; never "*" and never a pattern.
# Read by WebSocketConfig (env MANAO_WS_EXTRA_ORIGIN) to allow the browser WebSocket origin.
MANAO_WS_EXTRA_ORIGIN=

# Task-1-verified reclaim-capable RWX StorageClass for project workspaces (manao-poc4-delete).
# Read via application.yml manao.poc4.backend.workspace.storage-class-name.
MANAO_WORKSPACE_STORAGE_CLASS=manao-poc4-delete

# --- Deployment backend (non-secret, fixed in backend.yaml) ---
# Absolute login lifetime from sign-in; existing tokens retain their original expiry.
MANAO_JWT_LIFETIME=24h

# --- Secret manao-mysql-auth (generated per README "Secrets") ---
# MYSQL_ROOT_PASSWORD=        # random 32+ chars, admin of the single MySQL instance
# MYSQL_PASSWORD=             # random 32+ chars, the application DB user "manao"

# --- Secret manao-backend-auth (generated per README "Secrets") ---
# JWT_SECRET=                 # random 32+ chars (JwtService rejects shorter values)
# CAPABILITY_PRIVATE_KEY=     # 32 raw Ed25519 bytes, standard base64, see README
# CAPABILITY_PUBLIC_KEY=      # 32 raw Ed25519 bytes, standard base64, see README

# --- Secret manao-backend-images (digest-pinned image references) ---
# Backend image pushed from poc4/backend/Dockerfile, then pinned by digest, e.g.
#   chocologic/manao_images_repository@sha256:<64 hex>
# BACKEND_IMAGE=
# Task-1-verified digests from the private env file (do not invent or reuse placeholder
# zero digests - WorkspaceResourceFactory and JobResourceFactory reject non-digest refs):
# MANAO_WORKSPACE_AGENT_IMAGE=
# MANAO_WORKSPACE_INITIALIZER_IMAGE=
# MANAO_MAVEN_RUNNER_IMAGE=

# --- Values fixed by the manifests (listed here for reference only; do not override) ---
# SPRING_PROFILES_ACTIVE=cluster
# SERVER_PORT=8080
# MANAO_K8S_NAMESPACE=manao-stage6b
# MANAO_DB_URL is injected as the FQDN
#   jdbc:mysql://mysql.manao-stage6b.svc.cluster.local:3306/manao_poc4_6b
# (functionally equivalent to the contract literal jdbc:mysql://mysql:3306/manao_poc4_6b
# for a pod in the same namespace; see README section 7 for the recorded deviation)
# MANAO_DB_USERNAME=manao
