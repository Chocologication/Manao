# Multi-account backend configuration template (poc4/deploy/multi-account).
#
# Copy this file to a PRIVATE location, fill in the real runtime values, and never
# commit the filled copy. Everything in this template is either non-secret (the
# 126 SMTP endpoint values confirmed by the user) or an empty placeholder for a
# value that must be injected from a controlled environment / Kubernetes Secret.
#
# MANAO_MAIL_PASSWORD is the 126 client authorization code (NOT the mailbox web
# password). It must come from a runtime Secret or a controlled environment only.
# Never commit, print, log, echo it, or put it in test reports / handoff text.

# --- Release defaults -----------------------------------------------------
# Both stay false for this delivery. MANAO_REGISTRATION_ENABLED may be enabled
# only for the user-authorized manual registration acceptance window;
# MANAO_MAIL_ENABLED only after the runtime Secret is configured. Enabling the
# flags is a separate authorized operation, not part of the local artifacts.
MANAO_REGISTRATION_ENABLED=false
MANAO_MAIL_ENABLED=false

# --- 126 SMTP endpoint (non-secret values confirmed by the user 2026-10-29) ---
# 465 = implicit TLS (SSL); do not mix in STARTTLS and do not fall back to
# plaintext. The backend verifies the server certificate and hostname.
MANAO_MAIL_HOST=smtp.126.com
MANAO_MAIL_PORT=465
MANAO_MAIL_USERNAME=shilizhengnanren@126.com
MANAO_MAIL_FROM=shilizhengnanren@126.com
MANAO_MAIL_TLS_MODE=ssl

# 126 client authorization code. Runtime Secret / controlled environment only.
# Always empty in this repository. Never commit a real value anywhere.
MANAO_MAIL_PASSWORD=

# SMTP timeouts (milliseconds, fixed by design section 7). Defaults already match
# 5000 / 3000 / 5000 ms; listed only for explicit operators.
MANAO_MAIL_CONNECT_TIMEOUT=5s
MANAO_MAIL_READ_TIMEOUT=3s
MANAO_MAIL_WRITE_TIMEOUT=5s

# --- Auth challenge HMAC secret -------------------------------------------
# Server-side secret used to MAC image/email challenge answers. Generate at
# least 32 random bytes once per deployment, persist it in a runtime Secret
# (e.g. Kubernetes Secret manao-backend-auth key AUTH_CHALLENGE_SECRET), and
# never commit a real value.
MANAO_AUTH_CHALLENGE_SECRET=

# --- Database (required at runtime; credentials via Secret) ---------------
# Example in the Stage 6B cluster:
#   MANAO_DB_URL=jdbc:mysql://mysql.manao-stage6b.svc.cluster.local:3306/manao_poc4_6b
# Example for a local disposable schema on the operator host:
#   MANAO_DB_URL=jdbc:mysql://127.0.0.1:3306/manao_poc4_test
# Never point maintenance/testing at the running schemas unless that exact
# operation has been authorized.
MANAO_DB_URL=
MANAO_DB_USERNAME=manao
MANAO_DB_PASSWORD=

# --- JWT (server-side secret; >= 32 characters) ---------------------------
MANAO_JWT_SECRET=
MANAO_JWT_LIFETIME=24h
